{
  "name": "dark-planet-remastered",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "cd .. && uv run --with numpy --with pillow python tools/export_engine_data.py original_source game/public/data",
    "music": "cd .. && python3 tools/export_music.py original_source game/public/music",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
