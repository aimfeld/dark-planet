# Original game: Game/, CD/, Screenshots/, dplanet.conf and cdaudio/ are committed (playable
# in DOSBox-X from a clone). The disc image (330 MB; GitHub release `disc-image`), DOSBox-X captures and the tool output
# stay local; save/ is DOSBox-X's overlay for C: (own .gitignore). fastseek.lut: DOSBox-X's
# MP3 seek table.
original_source/Image/
original_source/capture/
original_source/extracted/
Thumbs.db
fastseek.lut

# Local tool/IDE state
.claude/settings.local.json
.idea/
.rea/
__pycache__/

# Build output
node_modules/
dist/


# Store screenshots (tools/screenshots.mjs)
screenshots/

# Input recordings of levels played in the dev build (game/src/recording.ts)
recordings/

# Gameplay videos (tools/trailer.mjs)
videos/

# The game build for the desktop app (game: npm run build:desktop)
desktop/app/
